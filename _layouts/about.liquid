---
layout: default
---
<div class="post">
  <article>
    <h2>About Me</h2>
    {{ page.intro | markdownify }}

    {% assign featured_chip = site.data.showcase.chips | first %}
    {% if featured_chip %}
      <section aria-labelledby="featured-chip-heading">
        <h2 id="featured-chip-heading">Featured Chip</h2>
        <a class="minimal-feature" href="{{ '/chip-design/' | relative_url }}#{{ featured_chip.id }}">
          <img src="{{ featured_chip.image | relative_url }}" alt="" width="{{ featured_chip.width }}" height="{{ featured_chip.height }}">
          <div>
            <strong>{{ featured_chip.title | escape }}</strong>
            <p>{{ featured_chip.description | escape }}</p>
            <span>View chip project <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {{ content }}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Personal Projects & DIY -->
    {% if page.projects %}
      <h2>Personal Projects & DIY</h2>
      {{ page.projects | markdownify }}
    {% endif %}

    <!-- Awards and Honors -->
    {% if page.awards %}
      <h2>Awards and Honors</h2>
      {{ page.awards | markdownify }}
    {% endif %}

    {% if site.contact_note %}<p class="minimal-contact-note">{{ site.contact_note }}</p>{% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
