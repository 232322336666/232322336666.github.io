<nav class="minimal-navigation" aria-label="Main navigation">
  {% for item in site.data.navigation %}
    {% if item.children %}
      {% assign child_urls = item.children | map: 'url' %}
      <details class="minimal-projects{% if child_urls contains page.url or page.url contains '/projects/' or page.url == '/outcomes/' %} is-current{% endif %}">
        <summary>{{ item.title | escape }}</summary>
        <ul class="minimal-submenu">
          {% for child in item.children %}
            <li>
              <a href="{{ child.url | relative_url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>
                {{- child.title | escape -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      </details>
    {% else %}
      <a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
        {{- item.title | escape -}}
      </a>
    {% endif %}
  {% endfor %}
  {% if site.search_enabled %}
    <button id="search-toggle" type="button" aria-label="Search" title="Search" onclick="openSearchModal()">
      <i class="ti ti-search" aria-hidden="true"></i>
    </button>
  {% endif %}
  {% if site.enable_darkmode %}
    <button id="light-toggle" type="button" aria-label="Change color theme" title="Change color theme">
      <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
      <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
      <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
    </button>
  {% endif %}
</nav>
